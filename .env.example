NODE_ENV=development
CONTROL_PORT=3000
LOG_LEVEL=info

# Phase 1 bot stores (separate from EventFlow production stores)
MONGODB_URI=mongodb://localhost:27017
BOT_DB_NAME=eventflow_supplier_bot
REDIS_URL=redis://localhost:6379
BOT_QUEUE_NAMESPACE=eventflow-supplier-bot

# Standalone Phase 1 Control Centre authentication.
# Use a long random secret in Railway. Phase 2 can move to EventFlow admin SSO.
CONTROL_ADMIN_KEY=replace-with-a-long-random-secret
CONTROL_SESSION_SECRET=replace-with-a-different-long-random-secret

# Absolute safety ceilings; the UI cannot configure above these values.
ABSOLUTE_MAX_PROFILES_PER_DAY=1000
ABSOLUTE_MAX_CRAWLS_PER_DAY=5000
ABSOLUTE_MAX_AI_SPEND_GBP_PER_DAY=50

# Discovery provider. Persistence stays disabled unless the account terms permit it.
BRAVE_API_KEY=
BRAVE_PERSISTENCE_ALLOWED=false

# Evidence-only semantic extraction. If OPENAI_API_KEY is empty the pipeline
# remains fully functional using deterministic extraction only.
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.6-luna
OPENAI_ESCALATION_MODEL=gpt-5.6-terra
OPENAI_MAX_EVIDENCE_FRAGMENTS=8
OPENAI_MAX_EVIDENCE_CHARS=14000
OPENAI_REQUEST_TIMEOUT_MS=45000
# Conservative accounting values; tune deliberately rather than silently raising limits.
OPENAI_BUDGET_RESERVATION_GBP_PER_CALL=0.10
OPENAI_ESTIMATED_GBP_PER_MILLION_TOKENS=8
OPENAI_CIRCUIT_FAILURE_THRESHOLD=5
OPENAI_CIRCUIT_OPEN_MINUTES=15

# Phase 2 only. The bot has no direct EventFlow Mongo access.
EVENTFLOW_INTERNAL_BASE_URL=
EVENTFLOW_BOT_HMAC_SECRET=
